{
  "$description": "Arivo design tokens — art direction 'Clean Blue': white surfaces, one confident blue, photo-led cards. Source of truth; run `node tools/tokens/build.mjs` to validate contrast and generate Dart + CSS. Token names are kept from the earlier 'Night Cartography' direction so existing widgets keep compiling.",
  "color": {
    "ink": {
      "950": "#0B1220",
      "900": "#111A2E",
      "800": "#1B2640",
      "700": "#26334F",
      "600": "#3A4A6E"
    },
    "paper": {
      "50": "#FFFFFF",
      "100": "#FFFFFF",
      "200": "#F3F6FB",
      "300": "#E4E8F0"
    },
    "text": {
      "onPaper": "#0F172A",
      "onPaperMuted": "#64748B",
      "onInk": "#F8FAFC",
      "onInkMuted": "#A5B1C8",
      "onVolt": "#FFFFFF"
    },
    "accent": {
      "$description": "volt = the brand blue used for primary buttons and selection.",
      "volt": "#1F6BFF",
      "signal": "#5B9BFF",
      "lantern": "#F59E0B",
      "ember": "#EF4444"
    },
    "accentOnPaper": {
      "$description": "Accent hues darkened for text/icons on white surfaces.",
      "volt": "#1A5FE6",
      "signal": "#1A5FE6",
      "lantern": "#B45309",
      "ember": "#DC2626"
    },
    "route": ["#1F6BFF", "#F97316", "#10B981", "#EC4899", "#8B5CF6", "#06B6D4", "#F59E0B", "#475569"],
    "crew": ["#1F6BFF", "#F59E0B", "#EC4899", "#8B5CF6", "#10B981", "#06B6D4"],
    "provenance": {
      "$description": "Every number shows where it came from: Live (provider data), Estimate (Arivo computed), You (user input).",
      "live": "#1F6BFF",
      "estimate": "#F59E0B",
      "you": "#10B981"
    }
  },
  "contrast": {
    "$description": "Pairs that must pass. ratio = minimum WCAG contrast.",
    "pairs": [
      ["text.onPaper", "paper.50", 7],
      ["text.onPaper", "paper.200", 7],
      ["text.onPaperMuted", "paper.50", 4.5],
      ["text.onPaperMuted", "paper.100", 4.5],
      ["text.onInk", "ink.950", 7],
      ["text.onInk", "ink.800", 7],
      ["text.onInkMuted", "ink.950", 4.5],
      ["text.onInkMuted", "ink.900", 4.5],
      ["text.onInkMuted", "ink.800", 4.5],
      ["text.onVolt", "accent.volt", 4.5],
      ["accent.signal", "ink.950", 4.5],
      ["accent.signal", "ink.800", 4.5],
      ["accent.lantern", "ink.950", 4.5],
      ["accent.ember", "ink.950", 4.5],
      ["accentOnPaper.volt", "paper.50", 4.5],
      ["accentOnPaper.signal", "paper.50", 4.5],
      ["accentOnPaper.lantern", "paper.50", 4.5],
      ["accentOnPaper.ember", "paper.50", 4.5],
      ["accentOnPaper.volt", "paper.200", 4.5],
      ["accentOnPaper.signal", "paper.200", 4.5]
    ]
  },
  "font": {
    "display": { "family": "Plus Jakarta Sans", "fallback": "system-ui, sans-serif" },
    "ui": { "family": "Plus Jakarta Sans", "fallback": "system-ui, sans-serif" },
    "mono": { "family": "Plus Jakarta Sans", "fallback": "system-ui, sans-serif" }
  },
  "type": {
    "displayXL": { "font": "display", "size": 34, "line": 40, "weight": 700, "tracking": -0.02 },
    "displayL": { "font": "display", "size": 28, "line": 34, "weight": 700, "tracking": -0.015 },
    "displayM": { "font": "display", "size": 24, "line": 30, "weight": 700, "tracking": -0.01 },
    "titleL": { "font": "ui", "size": 20, "line": 26, "weight": 700, "tracking": -0.01 },
    "titleM": { "font": "ui", "size": 17, "line": 22, "weight": 600, "tracking": -0.005 },
    "bodyL": { "font": "ui", "size": 16, "line": 24, "weight": 400, "tracking": 0 },
    "bodyM": { "font": "ui", "size": 14, "line": 20, "weight": 400, "tracking": 0 },
    "label": { "font": "ui", "size": 13, "line": 16, "weight": 600, "tracking": 0 },
    "caption": { "font": "ui", "size": 12, "line": 16, "weight": 500, "tracking": 0 },
    "monoL": { "font": "mono", "size": 22, "line": 28, "weight": 700, "tracking": -0.01 },
    "monoM": { "font": "mono", "size": 15, "line": 20, "weight": 600, "tracking": 0 },
    "monoS": { "font": "mono", "size": 12, "line": 16, "weight": 600, "tracking": 0.02 }
  },
  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "radius": { "xs": 8, "s": 12, "m": 14, "l": 24, "pill": 999 },
  "elevation": {
    "$description": "One soft shadow level for cards. Everything else separates by a 1px line.",
    "raised": { "y": 4, "blur": 16, "color": "#0F172A", "opacity": 0.07 }
  },
  "motion": {
    "duration": { "fast": 140, "base": 220, "slow": 420, "route": 700 },
    "easing": {
      "standard": [0.2, 0, 0, 1],
      "emphasized": [0.3, 0, 0, 1],
      "exit": [0.4, 0, 1, 1]
    }
  },
  "size": { "touchMin": 48, "fab": 60, "sheetHandle": 36 }
}
