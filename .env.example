# Copy to .env (never commit .env). Every key is optional: missing ones show a clear "not configured" state.
ENV=local

# --- AI (Claude via the official Anthropic SDK). Without a key Arivo runs deterministic planning + command mode.
ANTHROPIC_API_KEY=
MODEL_EXTRACT=claude-haiku-4-5
MODEL_PLAN=claude-sonnet-5
MODEL_REASON=claude-opus-5-5

# --- Supabase (local: `npx supabase start` prints these)
STORAGE=memory                      # memory | postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
ALLOW_DEV_AUTH=true                 # `Authorization: Dev <user-id>` — refused in production

# --- Privacy: key material for encrypting PII token maps (generate: python -c "import secrets;print(secrets.token_urlsafe(48))")
PII_KEY=

# --- Travel commerce (test/sandbox only outside production; the API refuses live keys in non-production envs)
DUFFEL_TOKEN=                       # duffel_test_…
DUFFEL_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=                  # sk_test_…
STRIPE_PUBLISHABLE_KEY=             # pk_test_… (the only Stripe key the app ever sees)
STRIPE_WEBHOOK_SECRET=

# --- Arivo Pulse sources (Wikipedia pageviews + GDELT work without keys)
YOUTUBE_API_KEY=
TICKETMASTER_KEY=

# --- Routing (optional; walking/transit fall back to labelled estimates)
ORS_API_KEY=
